global:
  scrape_interval: 30s
  evaluation_interval: 30s

alerting:
  alertmanagers:
    - static_configs:
      - targets:
        - alertmanager:9093

rule_files:
  - ./rules/*.yml

scrape_configs:
  - job_name: 'prometheus'
    scrape_interval: 30s
    static_configs:
      - targets: ['localhost:9090']
  - job_name: 'grafana'
    scrape_interval: 30s
    static_configs:
      - targets: ['grafana:3000']
  - job_name: 'node'
    scrape_interval: 30s
    static_configs:
      - targets: ['${LAN_HOST}:9100']
  - job_name: 'smart'
    scrape_interval: 30s
    static_configs:
      - targets: ['${LAN_HOST}:9633']
