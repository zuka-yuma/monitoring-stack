# 実際の値は .env にコピーして記入する。.env 自体は gitignore 対象。
# node_exporter / smartctl_exporter が動いているホストのLAN IP
LAN_HOST=192.168.1.100
# healthchecks.io などのDead Man's Switch ping URL（アラートマネージャ用）
DEADMANSSWITCH_URL=https://hc-ping.com/<your-uuid-here>
# 外形監視(blackbox_http)で疎通確認したいURL
BLACKBOX_HTTP_TARGET=https://your-domain.example.com
